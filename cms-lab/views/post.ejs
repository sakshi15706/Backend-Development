<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Post | Simple CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/posts">Simple CMS</a>
    <a class="btn" href="/posts/new">+ Create Post</a>
  </header>
  <main class="container">
    <article class="post-full">
      <h1><%= post.title %></h1>
      <p class="meta">By <%= post.author %></p>
      <p class="meta"><%= formatDate(post.createdAt) %></p>
      <div class="content"><%= post.content %></div>
    </article>
    <p><a class="link" href="/posts">&larr; Back to all posts</a></p>
  </main>
</body>
</html>
