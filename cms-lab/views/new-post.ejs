<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Post | Simple CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/posts">Simple CMS</a>
    <a class="btn" href="/posts/new">+ Create Post</a>
  </header>
  <main class="container">
    <h1>Create a Post</h1>

    <% if (errors.length > 0) { %>
      <ul class="errors">
        <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="/posts" method="POST" novalidate>
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value="<%= values.title || '' %>">

      <label for="content">Content</label>
      <textarea id="content" name="content" rows="8"><%= values.content || '' %></textarea>

      <label for="author">Author</label>
      <input type="text" id="author" name="author" value="<%= values.author || '' %>">

      <button type="submit" class="btn">Submit</button>
      <a href="/posts" class="link">Cancel</a>
    </form>
  </main>
</body>
</html>
